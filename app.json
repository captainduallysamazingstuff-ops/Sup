{
  "name": "AI Supervisor Factory",
  "description": "Telegram bot with AI agents",
  "repository": "https://github.com/captainduallysamazingstuff-ops/Sup",
  "keywords": ["telegram", "bot", "ai", "docker"],
  "env": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Your Telegram bot token from @BotFather",
      "required": true
    },
    "BACKEND_API_URL": {
      "description": "Backend API URL",
      "value": "https://ai-supervisor.fly.dev"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    },
    "worker": {
      "quantity": 1,
      "size": "free"
    }
  },
  "addons": [],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "scripts": {
    "dokku": {
      "postdeploy": "python -m pip install -r requirements.txt"
    }
  }
}
